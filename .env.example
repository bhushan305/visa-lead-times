# Server-only (never expose). Read in src/lib/supabase.server.ts and scripts/.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...        # read-only public key — used by the SSR repo
SUPABASE_SERVICE_ROLE_KEY=eyJ... # write key — used ONLY by scripts/cron sync

# Apps Script JSON API (the live fallback when Supabase is empty/unset).
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwF37kFPBEYOCS9t33Ai5gzoL_XkYBFfMsKzCt9SameFmPf30wOQkqbbqn53njCdrAZ/exec

# Used by sitemap.xml + canonical links. No trailing slash.
SITE_URL=https://usciscasestatus.fyi

# Shared secret for the daily cron endpoint at /api/cron/sync
CRON_SECRET=change-me-to-a-long-random-string

# Salt for hashing visitor IPs into stable pseudo-user-ids. Change this and
# every existing user gets a fresh id (useful if you ever need to "reset" tracking).
ANALYTICS_SALT=any-long-random-string

# Optional: switch deploy target. Default = vercel.
# DEPLOY_TARGET=vercel | netlify | cloudflare
